# ── IntentBridge AI — Environment Variables ───────────────────────────────────
# Copy this file to .env and fill in your real values.
# NEVER commit your .env file to version control.

# ── Google Cloud Project ───────────────────────────────────────────────────────
GOOGLE_CLOUD_PROJECT=your_gcp_project_id

# ── API Keys (or use Secret Manager for production) ────────────────────────────
# Obtain Gemini key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Obtain Places key at: https://console.cloud.google.com/apis/credentials
PLACES_API_KEY=your_places_api_key_here
